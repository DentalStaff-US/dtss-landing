{
	"name": "dtss-landing",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"start": "HOST=0.0.0.0 node ./dist/server/entry.mjs",
		"astro": "astro",
		"lint": "eslint . --ext .js,.mjs,.ts,.astro",
		"lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix",
		"format": "prettier --write \"src/**/*.{astro,ts,mjs,css}\" \"scripts/*.mjs\" astro.config.mjs",
		"format:check": "prettier --check \"src/**/*.{astro,ts,mjs,css}\" \"scripts/*.mjs\" astro.config.mjs",
		"type-check": "astro check",
		"check": "npm run type-check && npm run lint && npm run format:check",
		"seed:build": "node scripts/build-seed.mjs",
		"seed:apply": "emdash seed seed/seed.json",
		"og:build": "node scripts/build-og-image.mjs"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.0",
		"@astrojs/node": "^10.1.4",
		"@astrojs/react": "^5.0.0",
		"@aws-sdk/client-s3": "^3.1157.0",
		"@aws-sdk/s3-request-presigner": "^3.1157.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@iconify-json/tabler": "^1.2.26",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^6.0.4",
		"astro-icon": "^1.1.5",
		"emdash": "1.3.1",
		"posthog-js": "^1.438.21",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@tailwindcss/typography": "^0.5.19",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.57.0",
		"eslint-plugin-astro": "^1.6.0",
		"eslint-plugin-react": "^7.34.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"prettier": "^3.2.5",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3"
	}
}
