# --- App URLs (base URLs, no trailing slash, no /auth/... paths) -------------
# Required for a production build (see astro.config.mjs).
PUBLIC_PRACTICE_APP_URL=https://internal.dtstaffingsolutions.com
PUBLIC_PROFESSIONAL_APP_URL=https://app.dtstaffingsolutions.com
PUBLIC_PARTNER_PORTAL_URL=https://partners.dtstaffingsolutions.com
# Admin app serving /api/public/* for the job board (defaults to the practice app URL)
PUBLIC_ADMIN_API_URL=https://internal.dtstaffingsolutions.com
# Shared cookie domain so www / internal / app / partners all see dtss_ref + dtss_job.
# Leave unset in local dev.
PUBLIC_COOKIE_DOMAIN=.dtstaffingsolutions.com

# --- Job board -------------------------------------------------------------------
# Must match JOB_BOARD_SERVER_KEY in dental-staff-app; lets this server's API
# calls skip the admin app's per-IP rate limit. Server-only (no PUBLIC_ prefix).
JOB_BOARD_SERVER_KEY=

# --- Affiliate program -----------------------------------------------------------
# "true" once affiliate_program_enabled is on in production; otherwise /affiliates
# shows a waitlist instead of Apply / Sign in.
PUBLIC_AFFILIATE_PROGRAM_LIVE=false

# --- Forms (until the CRM is chosen) ---------------------------------------------
PUBLIC_WEB3FORMS_KEY=

# --- Analytics (same PostHog project as the apps) ------------------------------
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- EmDash CMS --------------------------------------------------------------------
# The Railway CMS Postgres — NOT the shared app DATABASE_URL. Unset locally → SQLite.
# Railway's public proxy needs TLS without CA verification: append ?sslmode=no-verify
EMDASH_DATABASE_URL=
# Generated on first run; BACK IT UP. Plugin secrets can't be decrypted without it.
EMDASH_ENCRYPTION_KEY=
# Media storage (DigitalOcean Spaces / any S3). Unset locally → ./.emdash/uploads
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
