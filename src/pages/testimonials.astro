---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { getTestimonials } from "@/lib/cms";

const all = await getTestimonials();
const practices = all.filter((t) => t.audience === "practice");
const professionals = all.filter((t) => t.audience === "professional");
---

<Layout
	title="Testimonials"
	description="What dentists, office managers, hygienists and assistants say about working with Dental Temps Staffing Solutions."
	breadcrumbs={[{ name: "Testimonials", href: "/testimonials" }]}
>
	<PageHero
		size="compact"
		eyebrow="Testimonials"
		title="What people say about DTSS"
		description="Practices and professionals on what it's like to work with DTSS."
	/>
	{
		practices.length > 0 && (
			<section class="py-16 sm:py-20" aria-labelledby="practices-heading">
				<Container>
					<SectionHeading
						id="practices-heading"
						align="left"
						eyebrow="From practices"
						title="Dental practices"
					/>
					<div class="mt-10">
						<Testimonials items={practices} layout="masonry" />
					</div>
				</Container>
			</section>
		)
	}
	{
		professionals.length > 0 && (
			<section
				class="bg-muted/50 py-16 sm:py-20"
				aria-labelledby="pros-heading"
			>
				<Container>
					<SectionHeading
						id="pros-heading"
						align="left"
						tone="pro"
						eyebrow="From professionals"
						title="Hygienists, assistants and dental professionals"
					/>
					<div class="mt-10">
						<Testimonials items={professionals} layout="masonry" />
					</div>
				</Container>
			</section>
		)
	}
	{
		all.length === 0 && (
			<section class="py-16 sm:py-20">
				<Container>
					<p class="text-muted-foreground">Testimonials coming soon.</p>
				</Container>
			</section>
		)
	}
	<CtaBand />
</Layout>
