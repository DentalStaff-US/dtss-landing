---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Prose from "@/components/ui/Prose.astro";
import Button from "@/components/ui/Button.astro";
import PostCard from "@/components/sections/PostCard.astro";
import { SITE } from "@/config/site.mjs";
import { getPost, getPosts, mediaUrl, ptToText } from "@/lib/cms";
import { appLink } from "@/lib/links";

const slug = Astro.params.slug!;
const post = await getPost(slug);
if (!post) return Astro.rewrite("/404");

const { posts: recent } = await getPosts({ perPage: 4 });
const related = recent.filter((p) => p.slug !== post.slug).slice(0, 3);
const image = mediaUrl(post.image);
const description = post.excerpt ?? ptToText(post.content, 160);
const forPros = post.audience === "professional";
const published = post.publishedAt?.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
});

const articleLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description,
	image: image ? new URL(image, SITE.url).href : undefined,
	datePublished: post.publishedAt?.toISOString(),
	dateModified: (post.updatedAt ?? post.publishedAt)?.toISOString(),
	author: {
		"@type": post.authorName ? "Person" : "Organization",
		name: post.authorName ?? SITE.legalName,
	},
	publisher: { "@id": `${SITE.url}/#organization` },
	mainEntityOfPage: new URL(`/blog/${post.slug}`, SITE.url).href,
};
---

<Layout
	title={post.title}
	description={description}
	ogType="article"
	ogImage={image}
	publishedTime={post.publishedAt?.toISOString()}
	modifiedTime={post.updatedAt?.toISOString()}
	breadcrumbs={[
		{ name: "Blog", href: "/blog" },
		{ name: post.title, href: `/blog/${post.slug}` },
	]}
	jsonLd={[articleLd]}
>
	<article>
		<header class="bg-gradient-to-br from-sky-50 via-white to-sky-100">
			<Container size="prose" class="py-14 sm:py-20">
				<a
					href="/blog"
					class="inline-flex items-center gap-1 text-sm font-semibold text-muted-foreground hover:text-foreground"
				>
					<Icon name="tabler:arrow-left" class="size-4" aria-hidden="true" /> All
					articles
				</a>
				{
					post.categories.length > 0 && (
						<ul class="mt-6 flex flex-wrap gap-2">
							{post.categories.map((c) => (
								<li>
									<a
										href={`/blog/category/${c.slug}`}
										class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary-dark hover:bg-primary/20"
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
				<h1 class="mt-4 text-4xl font-extrabold leading-tight sm:text-5xl">
					{post.title}
				</h1>
				<p class="mt-5 text-sm text-muted-foreground">
					{
						post.authorName && (
							<span class="font-semibold text-foreground">
								{post.authorName}
							</span>
						)
					}
					{post.authorName && published && " · "}
					{
						published && (
							<time datetime={post.publishedAt?.toISOString()}>
								{published}
							</time>
						)
					}
				</p>
			</Container>
		</header>

		{
			image && (
				<Container size="prose" class="-mt-2 pt-8">
					<img
						src={image}
						alt={post.image?.alt ?? ""}
						class="aspect-[16/9] w-full rounded-2xl object-cover shadow-lg"
						fetchpriority="high"
					/>
				</Container>
			)
		}

		<Container size="prose" class="py-12">
			<Prose value={post.content} />

			<aside
				class={`mt-14 rounded-2xl p-8 ring-1 ${forPros ? "bg-pro-soft ring-pro/20" : "bg-primary-soft ring-primary/20"}`}
			>
				<h2 class="text-xl font-extrabold">
					{
						forPros
							? "Looking for your next dental job?"
							: "Need reliable dental staff?"
					}
				</h2>
				<p class="mt-2 text-muted-foreground">
					{
						forPros
							? "Create a free DTSS profile to pick up temp shifts and permanent roles near you."
							: "Post a request and have a vetted professional assigned in minutes."
					}
				</p>
				<div class="mt-5 flex flex-wrap gap-3">
					{
						forPros ? (
							<>
								<Button
									href={appLink("pro", "sign-up")}
									variant="pro"
									data-track="signup_click"
									data-track-props='{"audience":"pro","placement":"blog"}'
								>
									Create your free profile
								</Button>
								<Button href="/jobs" variant="outline">
									Browse jobs
								</Button>
							</>
						) : (
							<>
								<Button
									href={appLink("practice", "sign-up")}
									data-track="signup_click"
									data-track-props='{"audience":"practice","placement":"blog"}'
								>
									Create a practice account
								</Button>
								<Button href="/practices" variant="outline">
									How it works
								</Button>
							</>
						)
					}
				</div>
			</aside>
		</Container>
	</article>

	{
		related.length > 0 && (
			<section class="border-t bg-muted/50 py-16">
				<Container>
					<h2 class="text-2xl font-extrabold">Keep reading</h2>
					<div class="mt-8 grid gap-6 md:grid-cols-3">
						{related.map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</Container>
			</section>
		)
	}
</Layout>
