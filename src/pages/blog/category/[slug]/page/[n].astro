---
import BlogIndex from "@/components/sections/BlogIndex.astro";
import { getCategories } from "@/lib/cms";

const category = (await getCategories()).find(
	(c) => c.slug === Astro.params.slug
);
if (!category) return Astro.rewrite("/404");
const n = Number(Astro.params.n);
if (!Number.isInteger(n) || n < 2)
	return Astro.redirect(`/blog/category/${category.slug}`, 301);
---

<BlogIndex page={n} category={category} />
