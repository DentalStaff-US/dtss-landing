---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Container from "@/components/ui/Container.astro";
import LeadForm from "@/components/forms/LeadForm.astro";
import { CONTACT } from "@/config/site.mjs";
import { getLocations } from "@/lib/cms";
import { appLink } from "@/lib/links";

const locations = await getLocations();
---

<Layout
	title="Contact Us"
	description="Get in touch with Dental Temps Staffing Solutions. Call (888) 653-1657, email dtss@dtstaffingsolutions.com, or send us a message."
	breadcrumbs={[{ name: "Contact", href: "/contact" }]}
>
	<PageHero
		size="compact"
		eyebrow="Contact"
		title="Get in touch today"
		description="Questions about staffing, finding work or partnering with us? We'd love to hear from you."
	/>

	<section class="py-16 sm:py-20">
		<Container>
			<div class="grid gap-12 lg:grid-cols-12">
				<div
					class="rounded-2xl border bg-white p-6 shadow-lg shadow-sky-900/5 sm:p-8 lg:col-span-7"
				>
					<h2 class="text-2xl font-extrabold">Send us a message</h2>
					<p class="mt-1 text-muted-foreground">
						We reply within one business day.
					</p>
					<div class="mt-6">
						<LeadForm
							kind="contact"
							fields={[
								"audience",
								"name",
								"email",
								"phone",
								"organization",
								"location",
								"message",
							]}
						/>
					</div>
				</div>

				<aside class="space-y-6 lg:col-span-5">
					<div class="rounded-2xl bg-navy p-8 text-white/85">
						<h2 class="text-lg font-bold text-white">Reach us directly</h2>
						<ul class="mt-5 space-y-4">
							<li>
								<a
									href={CONTACT.phoneHref}
									class="flex items-center gap-3 text-lg font-bold text-white hover:underline"
									><Icon
										name="tabler:phone"
										class="size-5"
										aria-hidden="true"
									/>{CONTACT.phone}</a
								>
							</li>
							<li>
								<a
									href={`mailto:${CONTACT.email}`}
									class="flex items-center gap-3 break-all hover:text-white"
									><Icon
										name="tabler:mail"
										class="size-5 shrink-0"
										aria-hidden="true"
									/>{CONTACT.email}</a
								>
							</li>
							<li class="flex items-center gap-3">
								<Icon
									name="tabler:printer"
									class="size-5"
									aria-hidden="true"
								/>Fax {CONTACT.fax}
							</li>
							<li class="flex items-start gap-3">
								<Icon
									name="tabler:building"
									class="mt-0.5 size-5"
									aria-hidden="true"
								/><address class="not-italic">
									Corporate headquarters<br />{CONTACT.hq.street}<br />{
										CONTACT.hq.city
									}, {CONTACT.hq.region}
									{CONTACT.hq.postalCode}
								</address>
							</li>
						</ul>
					</div>

					<div class="rounded-2xl border bg-white p-6 shadow-sm">
						<h2 class="font-bold">Already working with us?</h2>
						<p class="mt-1 text-sm text-muted-foreground">
							Sign in to message your staffing team directly.
						</p>
						<div class="mt-4 grid gap-2 sm:grid-cols-2">
							<a
								href={appLink("practice", "sign-in")}
								class="rounded-md border px-3 py-2 text-center text-sm font-semibold hover:bg-accent"
								>Practice portal</a
							>
							<a
								href={appLink("pro", "sign-in")}
								class="rounded-md border px-3 py-2 text-center text-sm font-semibold hover:bg-accent"
								>Professional portal</a
							>
						</div>
					</div>

					{
						locations.length > 0 && (
							<div class="rounded-2xl border bg-white p-6 shadow-sm">
								<h2 class="font-bold">Local staffing contacts</h2>
								<ul class="mt-4 divide-y text-sm">
									{locations.map((l) => (
										<li class="flex items-start justify-between gap-4 py-3">
											<span>
												<span class="block font-semibold">{l.region}</span>
												<span class="text-muted-foreground">
													{l.contactName}
												</span>
											</span>
											<span class="text-right text-muted-foreground">
												{l.extension && (
													<span class="block">ext. {l.extension}</span>
												)}
												{l.sms && (
													<a
														href={`sms:+1${l.sms.replace(/\D/g, "")}`}
														class="block hover:text-primary"
													>
														SMS {l.sms}
													</a>
												)}
											</span>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</aside>
			</div>
		</Container>
	</section>
</Layout>
