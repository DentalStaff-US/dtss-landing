---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import heroImage from "@/assets/hero-bg.jpg";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Steps from "@/components/sections/Steps.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import TrustBar from "@/components/sections/TrustBar.astro";
import PostCard from "@/components/sections/PostCard.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import JobCard from "@/components/jobs/JobCard.astro";
import { getPosts, getTestimonials } from "@/lib/cms";
import { getFacets, listJobs } from "@/lib/jobs";
import { appLink } from "@/lib/links";

const [testimonials, { posts }, jobsRes, facetsRes] = await Promise.all([
	getTestimonials({ featuredOnly: true }),
	getPosts({ perPage: 3 }),
	listJobs({ sort: "newest" }, 6),
	getFacets(),
]);
const jobs = jobsRes.ok ? jobsRes.data.jobs : [];
const totalJobs = jobsRes.ok ? jobsRes.data.total : 0;
const facets = facetsRes.ok ? facetsRes.data : null;
---

<Layout
	title="Dental Temp & Permanent Staffing | Dental Temps Staffing Solutions"
	rawTitle
	description="Dental staffing that feels personal. Book pre-screened hygienists, assistants and front office staff in minutes — or find flexible dental work with weekly pay. Free to join."
>
	<!-- HERO -->
	<section class="relative isolate overflow-hidden bg-white">
		<!-- Like the original site: the photo dissolves into white behind the copy. -->
		<div
			class="absolute inset-0 -z-10 bg-gradient-to-br from-white via-sky-50/60 to-sky-100"
			aria-hidden="true"
		>
		</div>
		<div class="absolute inset-0 -z-10">
			<Image
				src={heroImage}
				alt=""
				widths={[640, 960, 1400]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
				class="size-full object-cover object-left opacity-25 lg:opacity-100"
			/>
			<div
				class="absolute inset-0 hidden bg-gradient-to-r from-transparent from-30% via-white/85 via-55% to-sky-50/95 lg:block"
				aria-hidden="true"
			>
			</div>
		</div>

		<Container
			class="grid min-h-[620px] items-center py-16 lg:grid-cols-12 lg:py-24"
		>
			<div class="lg:col-span-6 lg:col-start-7">
				<p
					class="inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary-dark shadow-sm ring-1 ring-primary/20"
				>
					<Icon name="tabler:sparkles" class="size-4" aria-hidden="true" /> Dental
					staffing, reimagined
				</p>
				<h1
					class="mt-5 text-4xl font-extrabold leading-[1.05] sm:text-5xl lg:text-6xl"
				>
					It's a whole new <span class="text-primary">staffing experience.</span
					>
				</h1>
				<p
					class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/75 sm:text-xl"
				>
					We've combined proprietary staffing software with a small-town feel.
					Practices book vetted professionals in minutes; dental pros pick the
					shifts that fit their life — with real people behind every placement.
				</p>

				<div class="mt-8 grid gap-3 sm:grid-cols-2">
					<a
						href={appLink("practice", "sign-up")}
						class="group flex items-center gap-4 rounded-xl bg-primary p-4 text-primary-foreground shadow-lg shadow-sky-900/15 transition hover:bg-primary-dark"
						data-track="signup_click"
						data-track-props='{"audience":"practice","placement":"hero"}'
					>
						<span
							class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-white/15"
						>
							<Icon
								name="tabler:building-hospital"
								class="size-6"
								aria-hidden="true"
							/>
						</span>
						<span class="flex-1">
							<span
								class="block text-xs font-semibold uppercase tracking-wide text-white/75"
								>For practices</span
							>
							<span class="block font-bold">I need dental staff</span>
						</span>
						<Icon
							name="tabler:arrow-right"
							class="size-5 transition group-hover:translate-x-0.5"
							aria-hidden="true"
						/>
					</a>
					<a
						href={appLink("pro", "sign-up")}
						class="group flex items-center gap-4 rounded-xl bg-pro p-4 text-pro-foreground shadow-lg shadow-teal-900/15 transition hover:bg-pro-dark"
						data-track="signup_click"
						data-track-props='{"audience":"pro","placement":"hero"}'
					>
						<span
							class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-white/15"
						>
							<Icon
								name="tabler:stethoscope"
								class="size-6"
								aria-hidden="true"
							/>
						</span>
						<span class="flex-1">
							<span
								class="block text-xs font-semibold uppercase tracking-wide text-white/75"
								>For professionals</span
							>
							<span class="block font-bold">I'm looking for work</span>
						</span>
						<Icon
							name="tabler:arrow-right"
							class="size-5 transition group-hover:translate-x-0.5"
							aria-hidden="true"
						/>
					</a>
				</div>

				<form
					action="/jobs"
					method="get"
					class="mt-4 flex flex-col gap-2 rounded-xl bg-white p-2 shadow-md ring-1 ring-border sm:flex-row"
					role="search"
					aria-label="Search open dental jobs"
				>
					<label class="sr-only" for="hero-discipline">Role</label>
					<select
						id="hero-discipline"
						name="discipline"
						class="h-11 flex-1 rounded-md border-0 bg-transparent px-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-ring/30"
					>
						<option value="">Any role</option>
						{
							facets?.disciplines.map((d) => (
								<option value={d.id}>{d.name}</option>
							))
						}
					</select>
					<label class="sr-only" for="hero-state">State</label>
					<select
						id="hero-state"
						name="state"
						class="h-11 rounded-md border-0 bg-transparent px-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-ring/30 sm:w-36"
					>
						<option value="">Any state</option>
						{
							facets?.states.map((s) => (
								<option value={s.state}>{s.state}</option>
							))
						}
					</select>
					<button
						type="submit"
						class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-foreground px-5 text-sm font-bold text-white hover:bg-foreground/85"
					>
						<Icon name="tabler:search" class="size-4" aria-hidden="true" /> Find jobs
					</button>
				</form>
				{
					totalJobs > 0 && (
						<p class="mt-2 text-sm text-muted-foreground">
							<span class="font-bold text-pro-dark">
								{totalJobs} open {totalJobs === 1 ? "job" : "jobs"}
							</span>{" "}
							right now
						</p>
					)
				}
			</div>
		</Container>
	</section>

	<!-- PROOF POINTS -->
	<section class="border-y bg-white">
		<Container>
			<dl
				class="grid grid-cols-2 divide-x divide-y lg:grid-cols-4 lg:divide-y-0"
			>
				{
					[
						["Minutes", "to get a temp assigned through our software"],
						["W-2", "we're the employer of record — no 1099 headaches"],
						["Weekly", "direct-deposit pay for every professional"],
						["Since 1981", "our founder's career in dentistry"],
					].map(([stat, label]) => (
						<div class="px-4 py-8 text-center sm:px-8" data-reveal>
							<dt class="sr-only">{label}</dt>
							<dd class="text-3xl font-extrabold text-primary">{stat}</dd>
							<dd class="mt-1 text-sm text-muted-foreground">{label}</dd>
						</div>
					))
				}
			</dl>
		</Container>
	</section>

	<!-- AUDIENCE SPLIT -->
	<section class="py-20 sm:py-24" aria-labelledby="split-heading">
		<Container>
			<SectionHeading
				id="split-heading"
				eyebrow="Two sides, one platform"
				title="Built for practices and the professionals who power them"
			/>
			<div class="mt-14 grid gap-6 lg:grid-cols-2">
				<article
					class="flex flex-col rounded-2xl bg-gradient-to-br from-sky-50 via-white to-sky-100 p-8 ring-1 ring-primary/15 sm:p-10"
					data-reveal
				>
					<span
						class="inline-flex size-12 items-center justify-center rounded-xl bg-primary text-white"
					>
						<Icon
							name="tabler:building-hospital"
							class="size-6"
							aria-hidden="true"
						/>
					</span>
					<h3 class="mt-5 text-2xl font-extrabold">Get connected</h3>
					<p class="mt-2 text-muted-foreground">
						Don't let a call-out cost you a full day of production.
					</p>
					<ul class="mt-6 space-y-3">
						{
							[
								"Pre-screened hygienists, assistants, front office & more",
								"Post a shift and get someone assigned in minutes",
								"We handle payroll, workers' comp and payroll taxes",
								"Direct placement and temp-to-perm when you're ready to hire",
							].map((b) => (
								<li class="flex gap-3">
									<Icon
										name="tabler:circle-check-filled"
										class="mt-0.5 size-5 shrink-0 text-primary"
										aria-hidden="true"
									/>
									{b}
								</li>
							))
						}
					</ul>
					<div class="mt-8 flex flex-wrap gap-3 pt-2">
						<Button
							href={appLink("practice", "sign-up")}
							size="lg"
							data-track="signup_click"
							data-track-props='{"audience":"practice","placement":"split"}'
							>Create a practice account</Button
						>
						<Button href="/practices" variant="ghost" size="lg"
							>How it works <Icon
								name="tabler:arrow-right"
								aria-hidden="true"
							/></Button
						>
					</div>
				</article>
				<article
					class="flex flex-col rounded-2xl bg-gradient-to-br from-teal-50 via-white to-emerald-50 p-8 ring-1 ring-pro/15 sm:p-10"
					data-reveal
				>
					<span
						class="inline-flex size-12 items-center justify-center rounded-xl bg-pro text-white"
					>
						<Icon name="tabler:stethoscope" class="size-6" aria-hidden="true" />
					</span>
					<h3 class="mt-5 text-2xl font-extrabold">Get to work</h3>
					<p class="mt-2 text-muted-foreground">
						One day, three days or five weeks — you decide.
					</p>
					<ul class="mt-6 space-y-3">
						{
							[
								"Pick the shifts and offices that fit your schedule",
								"Weekly pay by direct deposit, and just one W-2",
								"Temp-to-perm and permanent roles when you want a home office",
								"Incentives, rewards and a team that actually knows you",
							].map((b) => (
								<li class="flex gap-3">
									<Icon
										name="tabler:circle-check-filled"
										class="mt-0.5 size-5 shrink-0 text-pro"
										aria-hidden="true"
									/>
									{b}
								</li>
							))
						}
					</ul>
					<div class="mt-8 flex flex-wrap gap-3 pt-2">
						<Button
							href={appLink("pro", "sign-up")}
							variant="pro"
							size="lg"
							data-track="signup_click"
							data-track-props='{"audience":"pro","placement":"split"}'
							>Create your free profile</Button
						>
						<Button href="/jobs" variant="ghost" size="lg"
							>Browse jobs <Icon
								name="tabler:arrow-right"
								aria-hidden="true"
							/></Button
						>
					</div>
				</article>
			</div>
		</Container>
	</section>

	<!-- LIVE JOBS -->
	{
		jobs.length > 0 && (
			<section
				class="bg-muted/50 py-20 sm:py-24"
				aria-labelledby="jobs-heading"
			>
				<Container>
					<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
						<SectionHeading
							id="jobs-heading"
							align="left"
							tone="pro"
							eyebrow="Hiring now"
							title="Open shifts & positions"
							description="A live look at roles practices need filled. Create a free profile to see the full details and apply."
						/>
						<Button href="/jobs" variant="pro" size="lg">
							See all {totalJobs} jobs
						</Button>
					</div>
					<ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{jobs.map((job) => (
							<JobCard job={job} />
						))}
					</ul>
				</Container>
			</section>
		)
	}

	<!-- HOW IT WORKS -->
	<section class="py-20 sm:py-24" aria-labelledby="how-heading">
		<Container>
			<SectionHeading
				id="how-heading"
				eyebrow="How it works"
				title="Simple for everyone. Personal at every step."
			/>
			<div class="mt-14 grid gap-16 lg:grid-cols-2 lg:gap-12">
				<div>
					<h3
						class="mb-8 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-primary-dark"
					>
						<Icon
							name="tabler:building-hospital"
							class="size-5"
							aria-hidden="true"
						/> For practices
					</h3>
					<Steps
						steps={[
							{
								title: "Create your account",
								body: "Add your practice, locations and team in a few minutes.",
							},
							{
								title: "Post a request",
								body: "Choose the role, dates, hours and rate you need.",
							},
							{
								title: "Get matched",
								body: "Qualified pros nearby are notified and assigned fast.",
							},
						]}
					/>
				</div>
				<div>
					<h3
						class="mb-8 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-pro-dark"
					>
						<Icon name="tabler:stethoscope" class="size-5" aria-hidden="true" /> For
						professionals
					</h3>
					<Steps
						tone="pro"
						steps={[
							{
								title: "Build your profile",
								body: "Experience, licenses and availability — all in one place.",
							},
							{
								title: "Get approved",
								body: "Our team reviews your credentials and welcomes you aboard.",
							},
							{
								title: "Pick your shifts",
								body: "Claim the work you want and get paid weekly.",
							},
						]}
					/>
				</div>
			</div>
		</Container>
	</section>

	<!-- SERVICES -->
	<section
		class="bg-gradient-to-b from-sky-50/70 to-white py-20 sm:py-24"
		aria-labelledby="services-heading"
	>
		<Container>
			<SectionHeading
				id="services-heading"
				eyebrow="You do dentistry. We do talent."
				title="Ways we help practices thrive"
			/>
			<div class="mt-14">
				<FeatureGrid
					columns={4}
					items={[
						{
							icon: "tabler:calendar-bolt",
							title: "Temporary staffing",
							body: "Experienced temps on demand to cover call-outs, leave and busy seasons — without the employment paperwork.",
						},
						{
							icon: "tabler:user-search",
							title: "Direct placement",
							body: "We're your outsourced recruiter: we define the role, post, screen and recommend — backed by a guarantee.",
						},
						{
							icon: "tabler:arrows-exchange",
							title: "Temp-to-perm",
							body: "Try before you hire. Bring someone on temporarily, then make it permanent for an agreed fee.",
						},
						{
							icon: "tabler:briefcase-2",
							title: "Workforce management",
							body: "Outsource payroll, HR and benefits administration — we become your silent partner.",
						},
					]}
				/>
			</div>
			<div class="mt-10 text-center">
				<Button href="/practices" variant="outline" size="lg"
					>Explore practice solutions</Button
				>
			</div>
		</Container>
	</section>

	<!-- TESTIMONIALS -->
	{
		testimonials.length > 0 && (
			<section class="py-20 sm:py-24" aria-labelledby="testimonials-heading">
				<Container>
					<SectionHeading
						id="testimonials-heading"
						eyebrow="Testimonials"
						title="What practices and professionals say"
					/>
					<div class="mt-12">
						<Testimonials items={testimonials.slice(0, 6)} />
					</div>
					<div class="mt-8 text-center">
						<Button href="/testimonials" variant="link">
							Read more testimonials{" "}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</Button>
					</div>
				</Container>
			</section>
		)
	}

	<TrustBar />

	<!-- BLOG -->
	{
		posts.length > 0 && (
			<section class="py-20 sm:py-24" aria-labelledby="blog-heading">
				<Container>
					<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
						<SectionHeading
							id="blog-heading"
							align="left"
							eyebrow="From the blog"
							title="Tips for practices & dental pros"
						/>
						<Button href="/blog" variant="outline">
							Visit the blog
						</Button>
					</div>
					<div class="mt-10 grid gap-6 md:grid-cols-3">
						{posts.map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</Container>
			</section>
		)
	}

	<CtaBand />
</Layout>
