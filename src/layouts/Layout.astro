---
import "@/styles/global.css";
import { CONTACT, SITE, SOCIAL } from "@/config/site.mjs";
import type { SEOProps } from "@/types/seo";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import AttributionScript from "@/components/AttributionScript.astro";
import Analytics from "@/components/Analytics.astro";

type Props = SEOProps;

const {
	title,
	rawTitle = false,
	description = SITE.description,
	canonicalURL,
	ogImage = SITE.ogImage,
	ogType = "website",
	noindex = false,
	jsonLd = [],
	breadcrumbs,
	publishedTime,
	modifiedTime,
} = Astro.props;

const fullTitle = !title
	? SITE.title
	: rawTitle
		? title
		: `${title} | ${SITE.shortName}`;
const canonical = new URL(canonicalURL || Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const organization = {
	"@context": "https://schema.org",
	"@type": "EmploymentAgency",
	"@id": `${SITE.url}/#organization`,
	name: SITE.legalName,
	alternateName: SITE.shortName,
	url: SITE.url,
	logo: `${SITE.url}/logo.png`,
	image: ogImageUrl,
	description: SITE.description,
	telephone: "+1-888-653-1657",
	faxNumber: "+1-360-654-6500",
	email: CONTACT.email,
	address: {
		"@type": "PostalAddress",
		streetAddress: CONTACT.hq.street,
		addressLocality: CONTACT.hq.city,
		addressRegion: CONTACT.hq.region,
		postalCode: CONTACT.hq.postalCode,
		addressCountry: CONTACT.hq.country,
	},
	areaServed: ["Florida", "Washington", "Texas", "Illinois"].map((name) => ({
		"@type": "State",
		name,
	})),
	sameAs: SOCIAL.map((s) => s.href),
};

const breadcrumbLd = breadcrumbs?.length
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [{ name: "Home", href: "/" }, ...breadcrumbs].map(
				(b, i) => ({
					"@type": "ListItem",
					position: i + 1,
					name: b.name,
					item: new URL(b.href, SITE.url).href,
				})
			),
		}
	: null;

const ldBlocks = [
	organization,
	...(breadcrumbLd ? [breadcrumbLd] : []),
	...jsonLd,
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#2a93d1" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={noindex
				? "noindex, follow"
				: "index, follow, max-image-preview:large"}
		/>
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="en_US" />
		{
			publishedTime && (
				<meta property="article:published_time" content={publishedTime} />
			)
		}
		{
			modifiedTime && (
				<meta property="article:modified_time" content={modifiedTime} />
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@DentalTempsSS" />

		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${SITE.name} Blog`}
			href="/blog/rss.xml"
		/>

		{
			ldBlocks.map((ld) => (
				<script type="application/ld+json" set:html={JSON.stringify(ld)} />
			))
		}

		<!-- Opt into scroll-reveal only when JS runs (see global.css). -->
		<script is:inline>
			document.documentElement.classList.add("js-reveal");
		</script>
		<Analytics />
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
		>
			Skip to main content
		</a>
		<Header />
		<main id="main-content" class="flex-1">
			<slot />
		</main>
		<Footer />
		<AttributionScript />
		<script>
			const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if ("IntersectionObserver" in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add("is-visible");
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: "0px 0px -10% 0px" }
				);
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add("is-visible"));
			}
		</script>
	</body>
</html>
