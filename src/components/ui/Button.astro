---
/**
 * Mirrors the apps' shadcn button (dental-staff-app/src/lib/components/ui/button)
 * — same radius, weights, focus ring — plus marketing sizes (xl) and the
 * professional-side `pro` variant.
 */
import type { HTMLAttributes } from "astro/types";

type Variant =
	| "default"
	| "pro"
	| "outline"
	| "outline-white"
	| "secondary"
	| "ghost"
	| "link"
	| "white";
type Size = "sm" | "default" | "lg" | "xl" | "icon";

type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) & {
	href?: string;
	variant?: Variant;
	size?: Size;
	class?: string;
	external?: boolean;
};

const {
	href,
	variant = "default",
	size = "default",
	class: className = "",
	external = false,
	...rest
} = Astro.props;

const base =
	"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:size-4 [&_svg]:shrink-0";

const variants: Record<Variant, string> = {
	default: "bg-primary text-primary-foreground shadow-sm hover:bg-primary-dark",
	pro: "bg-pro text-pro-foreground shadow-sm hover:bg-pro-dark",
	outline:
		"border border-input bg-background hover:bg-accent hover:text-accent-foreground",
	"outline-white": "border border-white/70 text-white hover:bg-white/10",
	secondary: "bg-secondary text-secondary-foreground hover:bg-secondary/80",
	ghost: "hover:bg-accent hover:text-accent-foreground",
	link: "text-primary underline-offset-4 hover:underline",
	white: "bg-white text-primary-dark shadow-sm hover:bg-primary-soft",
};

const sizes: Record<Size, string> = {
	sm: "h-9 px-3 text-sm",
	default: "h-10 px-4 text-sm",
	lg: "h-11 px-6 text-base",
	xl: "h-13 px-8 text-base sm:text-lg",
	icon: "h-10 w-10",
};

const classes = [base, variants[variant], sizes[size], className].join(" ");
const externalAttrs = external
	? { target: "_blank", rel: "noopener noreferrer" }
	: {};
---

{
	href ? (
		<a
			href={href}
			class={classes}
			{...externalAttrs}
			{...(rest as HTMLAttributes<"a">)}
		>
			<slot />
		</a>
	) : (
		<button class={classes} {...(rest as HTMLAttributes<"button">)}>
			<slot />
		</button>
	)
}
