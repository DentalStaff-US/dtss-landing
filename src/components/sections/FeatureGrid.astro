---
import { Icon } from "astro-icon/components";

export interface Feature {
	icon: string;
	title: string;
	body: string;
}
interface Props {
	items: Feature[];
	tone?: "primary" | "pro";
	columns?: 2 | 3 | 4;
}
const { items, tone = "primary", columns = 3 } = Astro.props;
const cols = {
	2: "sm:grid-cols-2",
	3: "sm:grid-cols-2 lg:grid-cols-3",
	4: "sm:grid-cols-2 lg:grid-cols-4",
}[columns];
const iconBg =
	tone === "pro" ? "bg-pro/10 text-pro" : "bg-primary/10 text-primary";
---

<ul class={`grid gap-6 ${cols}`}>
	{
		items.map((f) => (
			<li class="rounded-xl border bg-white p-6 shadow-sm" data-reveal>
				<span
					class={`inline-flex size-12 items-center justify-center rounded-lg ${iconBg}`}
				>
					<Icon name={f.icon} class="size-6" aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-lg font-bold">{f.title}</h3>
				<p class="mt-2 leading-relaxed text-muted-foreground">{f.body}</p>
			</li>
		))
	}
</ul>
