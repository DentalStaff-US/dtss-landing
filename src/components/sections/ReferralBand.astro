---
/**
 * Referral rewards pitch for people who already know DTSS. Copy follows the
 * same program switch as /affiliates: a waitlist until it's live in production.
 */
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { ENV } from "@/lib/env";

const live = ENV.affiliateProgramLive;
const facts = [
	["2.5%", "of regular hours on paid temp shifts"],
	["90 days", "for a referral to sign up"],
	["$25", "minimum payout, paid to your bank"],
];
---

<section class="pb-20 sm:pb-24" aria-labelledby="referral-heading">
	<Container>
		<div
			class="grid items-center gap-10 rounded-2xl bg-navy p-8 text-white/85 shadow-xl sm:p-12 lg:grid-cols-2"
			data-reveal
		>
			<div>
				<p class="text-xs font-bold uppercase tracking-wide text-sky-300">
					{live ? "Referral rewards" : "Referral rewards · coming soon"}
				</p>
				<h2
					id="referral-heading"
					class="mt-3 text-3xl font-extrabold text-white"
				>
					Know a practice or professional we should meet?
				</h2>
				<p class="mt-4 text-lg leading-relaxed">
					{
						live
							? "Refer them to DTSS and earn a share of the temp shifts they work. It's open to practices, professionals and outside partners."
							: "Soon you'll be able to refer them to DTSS and earn a share of the temp shifts they work. Join the waitlist and we'll invite you when the program opens."
					}
				</p>
				<Button
					href={live ? "/affiliates" : "/affiliates#waitlist"}
					variant="white"
					size="lg"
					class="mt-6"
				>
					{live ? "See how referral rewards work" : "Join the waitlist"}
				</Button>
			</div>
			<dl class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
				{
					facts.map(([stat, label]) => (
						<div class="flex flex-col rounded-xl bg-white/5 p-4 ring-1 ring-white/10 lg:flex-row lg:items-center lg:gap-4">
							<dt class="sr-only">{label}</dt>
							<dd class="text-2xl font-extrabold text-white lg:w-28 lg:shrink-0">
								{stat}
							</dd>
							<dd class="text-sm">{label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</Container>
</section>
