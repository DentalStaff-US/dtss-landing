---
import { Icon } from "astro-icon/components";
import Prose from "@/components/ui/Prose.astro";
import { ptToText, type Faq } from "@/lib/cms";

interface Props {
	items: Faq[];
	/** Emit FAQPage JSON-LD. Only one FAQPage per URL, so the caller decides. */
	jsonLd?: boolean;
	tone?: "primary" | "pro";
}
const { items, jsonLd = false, tone = "primary" } = Astro.props;

const ld = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: items.map((f) => ({
		"@type": "Question",
		name: f.question,
		acceptedAnswer: { "@type": "Answer", text: ptToText(f.answer, 2000) },
	})),
};
---

{
	jsonLd && items.length > 0 && (
		<script type="application/ld+json" set:html={JSON.stringify(ld)} />
	)
}
<div class="divide-y rounded-xl border bg-white shadow-sm">
	{
		items.map((f) => (
			<details class="group px-6" name="faq">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-bold [&::-webkit-details-marker]:hidden">
					{f.question}
					<span
						class={`flex size-8 shrink-0 items-center justify-center rounded-full transition group-open:rotate-45 ${tone === "pro" ? "bg-pro/10 text-pro" : "bg-primary/10 text-primary"}`}
						aria-hidden="true"
					>
						<Icon name="tabler:plus" class="size-4" />
					</span>
				</summary>
				<div class="pb-6 pr-12">
					<Prose value={f.answer} size="sm" class="text-muted-foreground" />
				</div>
			</details>
		))
	}
	{
		items.length === 0 && (
			<p class="p-6 text-muted-foreground">
				Questions? Call us — we're happy to help.
			</p>
		)
	}
</div>
