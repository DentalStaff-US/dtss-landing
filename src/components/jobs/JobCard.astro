---
import { Icon } from "astro-icon/components";
import {
	formatDate,
	formatTime,
	jobPay,
	jobPlace,
	jobTitle,
	postedAgo,
	type PublicJob,
} from "@/lib/jobs";

interface Props {
	job: PublicJob;
}
const { job } = Astro.props;
const isPerm = job.type === "perm";
const next = !job.schedule.permanent ? job.schedule.nextDates[0] : null;
const more = !job.schedule.permanent ? job.schedule.openDateCount - 1 : 0;
---

<li>
	<article
		class="group relative flex h-full flex-col rounded-xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-sky-900/5"
	>
		<div class="flex items-start justify-between gap-3">
			<span
				class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide ${isPerm ? "bg-primary/10 text-primary-dark" : "bg-pro/10 text-pro-dark"}`}
			>
				<Icon
					name={isPerm ? "tabler:briefcase" : "tabler:calendar-event"}
					class="size-3.5"
					aria-hidden="true"
				/>
				{isPerm ? "Permanent" : "Temp"}
			</span>
			<span class="text-xs text-muted-foreground"
				>{postedAgo(job.postedAt)}</span
			>
		</div>

		<h3 class="mt-3 text-lg font-bold leading-snug">
			<a
				href={`/jobs/${job.publicId}`}
				class="after:absolute after:inset-0 hover:text-primary"
				data-job-open={job.publicId}
				data-track="job_view"
				data-track-props={JSON.stringify({
					type: job.type,
					discipline: job.discipline.name,
				})}
			>
				{jobTitle(job)}
			</a>
		</h3>

		<ul class="mt-3 space-y-1.5 text-sm text-muted-foreground">
			<li class="flex items-center gap-2">
				<Icon
					name="tabler:map-pin"
					class="size-4 shrink-0"
					aria-hidden="true"
				/>
				{jobPlace(job)}
				{
					job.distanceMiles != null && (
						<span class="text-xs">· ~{job.distanceMiles} mi</span>
					)
				}
			</li>
			<li class="flex items-center gap-2">
				<Icon name="tabler:cash" class="size-4 shrink-0" aria-hidden="true" />
				<span class={job.payRate ? "font-bold text-foreground" : ""}
					>{jobPay(job)}</span
				>
			</li>
			{
				next && (
					<li class="flex items-center gap-2">
						<Icon
							name="tabler:clock"
							class="size-4 shrink-0"
							aria-hidden="true"
						/>
						{`${formatDate(next.date, { weekday: "short", month: "short", day: "numeric" })}, ${formatTime(next.start)}–${formatTime(next.end)}`}
						{more > 0 && (
							<span class="text-xs font-semibold text-pro-dark">
								+{more} more
							</span>
						)}
					</li>
				)
			}
			{
				job.experienceLevel && (
					<li class="flex items-center gap-2">
						<Icon
							name="tabler:award"
							class="size-4 shrink-0"
							aria-hidden="true"
						/>
						{job.experienceLevel}
					</li>
				)
			}
		</ul>

		{
			job.skills.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-1.5">
					{job.skills
						.flatMap((g) => g.skills)
						.slice(0, 4)
						.map((s) => (
							<li class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium">
								{s.name}
							</li>
						))}
				</ul>
			)
		}

		<span
			class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-bold text-primary"
		>
			View details
			<Icon
				name="tabler:arrow-right"
				class="size-4 transition group-hover:translate-x-0.5"
				aria-hidden="true"
			/>
		</span>
	</article>
</li>
